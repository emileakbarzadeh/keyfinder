+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn progress_is_visible_through_a_pipe() {
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", "tests::progress_output_fixture", "--nocapture", "--quiet"])
+            .env("ZAPP_PROGRESS_OUTPUT_FIXTURE", "1")
+            .env("TERM", "dumb")
+            .env("NO_COLOR", "1")
+            .output()
+            .unwrap();
+        assert!(output.status.success(), "{output:?}");
+        let stdout = String::from_utf8(output.stdout).unwrap();
+        let messages: Vec<_> = stdout
+            .lines()
+            .filter(|line| {
+                line.starts_with("Waiting for")
+                    || line.starts_with("Erasing...")
+                    || line.starts_with("Writing...")
+                    || line.starts_with("Resetting...")
+                    || *line == "Done!"
+            })
+            .collect();
+        assert_eq!(
+            messages,
+            [
+                "Waiting for keyboard in bootloader mode. Press your keyboard's reset button...",
+                "Erasing... 1%",
+                "Erasing... 100%",
+                "Writing... 1%",
+                "Writing... 100%",
+                "Resetting... 100%",
+                "Done!",
+            ]
+        );
+        assert!(!stdout.contains('\x1b'));
+    }
+
+    #[test]
+    fn progress_output_fixture() {
+        // Rendering only: never enumerate USB devices or flash firmware.
+        if std::env::var_os("ZAPP_PROGRESS_OUTPUT_FIXTURE").is_none() {
+            return;
+        }
+        let spinner = new_spinner(
+            "Waiting for keyboard in bootloader mode. Press your keyboard's reset button...",
+        );
+        assert!(spinner.is_hidden());
+        spinner.finish_and_clear();
+        let pb = ProgressBar::new(100);
+        for bytes in [10, 11, 1000] {
+            report_flash_progress(
+                &pb,
+                FlashProgress::Erasing {
+                    bytes_erased: bytes,
+                    total_bytes: 1000,
+                },
+            );
+        }
+        for bytes in [10, 11, 1000] {
+            report_flash_progress(
+                &pb,
+                FlashProgress::Writing {
+                    bytes_written: bytes,
+                    total_bytes: 1000,
+                },
+            );
+        }
+        report_flash_progress(&pb, FlashProgress::Resetting);
+        report_flash_progress(&pb, FlashProgress::Complete);
+    }
